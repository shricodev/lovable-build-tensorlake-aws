{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LovableDiyObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::LOVABLE_DIY_BUCKET_NAME/*"
    },
    {
      "Sid": "LovableDiyBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::LOVABLE_DIY_BUCKET_NAME"
    }
  ]
}
