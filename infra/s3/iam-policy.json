{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KilnObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::KILN_BUCKET_NAME/*"
    },
    {
      "Sid": "KilnBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::KILN_BUCKET_NAME"
    }
  ]
}
