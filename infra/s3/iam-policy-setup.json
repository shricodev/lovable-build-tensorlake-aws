{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KilnBucketBootstrapOnly",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketCORS"
      ],
      "Resource": "arn:aws:s3:::KILN_BUCKET_NAME"
    }
  ]
}
