# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://kiln:kiln@localhost:5432/kiln

# ─── Tensorlake ──────────────────────────────────────────────────────────
# Create a key at https://cloud.tensorlake.ai
TENSORLAKE_API_KEY=
# Optional overrides (defaults: https://api.tensorlake.ai, https://sandbox.tensorlake.ai)
# TENSORLAKE_API_URL=
# TENSORLAKE_SANDBOX_PROXY_URL=
# Free tier = 1 concurrent sandbox. Raise when your plan allows more.
SANDBOX_CONCURRENCY_LIMIT=1
# Idle seconds before Tensorlake auto-suspends a named sandbox (free tier max 7200).
SANDBOX_IDLE_TIMEOUT_SECS=600
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=1024

# ─── Object storage (MinIO locally, S3 in the demo) ──────────────────────
S3_BUCKET=kiln
S3_REGION=us-east-1
# Remove the next two lines to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=kiln
AWS_SECRET_ACCESS_KEY=kiln-dev-secret

# ─── LLM ─────────────────────────────────────────────────────────────────
# Set at least one. Models are chosen per role as provider:model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_CODER=anthropic:claude-sonnet-5
LLM_SUMMARIZER=anthropic:claude-haiku-4-5
# e.g. LLM_CODER=openai:gpt-5  or  LLM_CODER=ollama:qwen3-coder
MAX_HEAL_ROUNDS=3

# ─── Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app (see README "GitHub OAuth"). Optional while DEV_LOGIN=true.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Dev-only login without GitHub. Always disabled when NODE_ENV=production.
DEV_LOGIN=true
ADMIN_GITHUB_USERNAMES=

# ─── URLs ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
PREVIEW_BASE_DOMAIN=preview.localhost:4000
PREVIEW_PROTOCOL=http
