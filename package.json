{
  "name": "lovable-diy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "s3:setup": "tsx --env-file-if-exists=.env infra/s3/setup-bucket.ts",
    "spike": "tsx --env-file-if-exists=.env",
    "sandbox:build-base": "pnpm --filter @lovable-diy/sandbox build-base",
    "sandbox:bench": "pnpm --filter @lovable-diy/sandbox bench",
    "agent:run": "pnpm --filter @lovable-diy/worker agent:run",
    "dev": "turbo run dev --filter=@lovable-diy/web --filter=@lovable-diy/worker --filter=@lovable-diy/gateway",
    "db:migrate": "pnpm --filter @lovable-diy/db db:migrate",
    "db:generate": "pnpm --filter @lovable-diy/db db:generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "pnpm --filter @lovable-diy/worker eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "@lovable-diy/storage": "workspace:*",
    "@lovable-diy/shared": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
